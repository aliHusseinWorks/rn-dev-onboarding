# Optional override for the detect-scan relay URL. Normally UNSET:
# - deployed (Cloudflare Pages): the page uses its own origin — the relay is
#   a Pages Function on the same domain (functions/report/[code].ts)
# - pnpm dev: /report is proxied to wrangler pages dev on :8788 (vite.config.ts)
# Set this only to point the app at a different relay explicitly.
# VITE_DETECT_ENDPOINT=
