{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/pnpm-lock.yaml)",
      "Edit(/dist/**)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --amend *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "PowerShell(npm *)",
      "PowerShell(yarn *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git commit --amend *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"" }]
      }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"" }] }]
  }
}
